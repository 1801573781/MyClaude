{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["WB_API_BASE_URL", "WB_MOCK_MODEL", "WB_TELEMETRY_OPT_IN_DEFAULT", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"]
    },
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
