{
  "name": "@wdbuddy/skill-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "WDBuddy 技能定义 SDK：manifest + 声明式权限（§10.6），兼容 OpenClaw 生态",
  "type": "module",
  "main": "./dist/index.js",
