# 忽略所有 .pyc 文件
*.pyc

# 忽略整个目录
.memdir/
.memdir_test/
__pycache__/
venv/
.venv/
.idea/
.pytest_cache/
.ruff_cache/
logo/
A2A_EX_Problem/
openspec/
src/crawler/
src/spider/
src/chicken_farm/

# 忽略这些目录下的所有内容
code_output/*
context/*
log/*
spec/*
memory_storage/*
tests/*

# 但是保留这些目录本身（通过.gitkeep）
!code_output/.gitkeep
!context/.gitkeep
!log/.gitkeep
!spec/.gitkeep
!spec/myclaude_test_spec.md
!spec/unit_test_case_generator_spec.md
!spec/unit_test_spec_origin.txt
!memory_storage/.gitkeep
!tests/.gitkeep


